{
  "_comment": "Customer tenant deployment (apps.central-office.info/mailgateway, service on port 5000). Copy to appsettings.Production.json next to MailGateway.dll and fill in the secrets. Never commit the filled-in file.",

  "Urls": "http://localhost:5000",

  "Security": {
    "ApiKey": "<< existing customer API key >>",
    "ApiKeys": []
  },

  "Graph": {
    "TenantId": "<< customer tenant id >>",
    "ClientId": "<< app registration client id >>",
    "ClientSecret": "<< app registration client secret >>",
    "Sender": "mail-sender@central-office.info",
    "SendMode": "auto",
    "SaveToSentItems": false
  },

  "MailSecurity": {
    "AllowCustomFrom": true,
    "AllowedFromAddresses": [
      "noreply@aps1888.org",
      "noreply@societyforpediatricresearch.org",
      "noreply@pas-meeting.org",
      "noreply@pasmeeting.org",
      "info@aps1888.org",
      "info@societyforpediatricresearch.org",
      "info@pas-meeting.org",
      "info@pasmeeting.org",
      "mail-sender@central-office.info",
      "infospr@aps-spr.org",
      "info@pediasphere.ai",
      "noreply@pediasphere.ai"
    ],
    "AllowedFromDomains": [
      "aps1888.org",
      "societyforpediatricresearch.org",
      "pas-meeting.org",
      "pasmeeting.org",
      "central-office.info",
      "aps-spr.org",
      "pediasphere.ai"
    ]
  },

  "Logging": {
    "Folder": "C:\\Apps\\MailGateway\\Logs"
  },

  "MailLimits": {
    "MaxAttachments": 10,
    "MaxAttachmentBytes": 25000000,
    "MaxTotalAttachmentBytes": 25000000,
    "AllowedAttachmentRoot": "C:\\inetpub\\wwwroot\\",
    "MaxRequestBodyBytes": 67108864,
    "InlineSendThresholdBytes": 3000000,
    "UploadChunkBytes": 3276800
  }
}
